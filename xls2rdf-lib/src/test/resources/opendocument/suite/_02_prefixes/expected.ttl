@prefix concept-status: <http://publications.europa.eu/resource/authority/concept-status/> .
@prefix days: <http://data.sparna.fr/vocabularies/days#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix euvoc: <http://publications.europa.eu/ontology/euvoc#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://data.sparna.fr/vocabularies/days> a skos:ConceptScheme;
  dct:description "The days of the week";
  dct:title "Weekdays";
  skos:hasTopConcept days:friday, days:monday, days:thursday, days:tuesday, days:wednesday,
    days:week-end .

days:monday a skos:Concept;
  euvoc:status concept-status:CURRENT;
  skos:definition "The day where you get back at work";
  skos:inScheme <http://data.sparna.fr/vocabularies/days>;
  skos:notation "MON";
  skos:prefLabel "Monday";
  skos:topConceptOf <http://data.sparna.fr/vocabularies/days> .

days:tuesday a skos:Concept;
  euvoc:status concept-status:CURRENT;
  skos:definition "The most productive day of the week.";
  skos:inScheme <http://data.sparna.fr/vocabularies/days>;
  skos:notation "TUE";
  skos:prefLabel "Tuesday";
  skos:topConceptOf <http://data.sparna.fr/vocabularies/days> .

days:wednesday a skos:Concept;
  euvoc:status concept-status:CURRENT;
  skos:inScheme <http://data.sparna.fr/vocabularies/days>;
  skos:notation "WED";
  skos:prefLabel "Wednesday";
  skos:topConceptOf <http://data.sparna.fr/vocabularies/days> .

days:thursday a skos:Concept;
  euvoc:status concept-status:CURRENT;
  skos:inScheme <http://data.sparna.fr/vocabularies/days>;
  skos:notation "THU";
  skos:prefLabel "Thursday";
  skos:topConceptOf <http://data.sparna.fr/vocabularies/days> .

days:friday a skos:Concept;
  euvoc:status concept-status:CURRENT;
  skos:definition "Week-end soon !";
  skos:inScheme <http://data.sparna.fr/vocabularies/days>;
  skos:notation "FRI";
  skos:prefLabel "Friday";
  skos:topConceptOf <http://data.sparna.fr/vocabularies/days> .

days:saturday a skos:Concept;
  euvoc:status concept-status:CURRENT;
  skos:broader days:week-end;
  skos:inScheme <http://data.sparna.fr/vocabularies/days>;
  skos:notation "SAT";
  skos:prefLabel "Saturday" .

days:sunday a skos:Concept;
  euvoc:comment "Note that some consider Sunday to be the first day of the week. Should we give ordering numbers to weekdays ?";
  euvoc:status concept-status:CURRENT;
  skos:broader days:week-end;
  skos:definition "The day you sleep.";
  skos:inScheme <http://data.sparna.fr/vocabularies/days>;
  skos:notation "SUN";
  skos:prefLabel "Sunday" .

days:week-end a skos:Concept;
  euvoc:comment "Check with Andrew if the concept of Week-end is the same in the US, in China and the UK. Try to determine a universal notion of what a \"week-end\" is.";
  euvoc:status concept-status:TESTING;
  skos:definition "Any day of the week-end";
  skos:inScheme <http://data.sparna.fr/vocabularies/days>;
  skos:narrower days:saturday, days:sunday;
  skos:notation "WKND";
  skos:prefLabel "Week-end";
  skos:topConceptOf <http://data.sparna.fr/vocabularies/days> .
